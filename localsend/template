# Template file for 'localsend'
pkgname=localsend
version=1.18.2
revision=2
archs="x86_64"
create_wrksrc=yes
depends="gtk+3 desktop-file-utils hicolor-icon-theme"
short_desc="Cross-platform AirDrop alternative for nearby sharing"
maintainer="Dicov <SrDicov@gmail.com>"
license="Apache-2.0"
homepage="https://localsend.org"
distfiles="https://github.com/localsend/localsend/releases/download/v${version}/LocalSend-${version}-linux-x86-64.tar.gz"
checksum=287690a9a8eb6da9c83cc97b3e3030ac67daf32a7331fcf307d0939300658d16
replaces="localsend-bin>=0"
provides="localsend-bin-${version}_${revision}"
nodebug=yes
nostrip=yes

do_install() {
	vmkdir usr/lib/localsend
	vcopy "*" usr/lib/localsend
	chmod 755 "${DESTDIR}/usr/lib/localsend/localsend_app"

	vmkdir usr/bin
	cat <<-'EOF' > "${DESTDIR}/usr/bin/localsend"
	#!/bin/sh
	exec /usr/lib/localsend/localsend_app "$@"
	EOF
	chmod 755 "${DESTDIR}/usr/bin/localsend"

	vmkdir usr/share/icons/hicolor/512x512/apps
	vinstall data/flutter_assets/assets/img/logo-512.png 644 usr/share/icons/hicolor/512x512/apps localsend.png

	vmkdir usr/share/applications
	cat <<-'EOF' > "${DESTDIR}/usr/share/applications/localsend.desktop"
	[Desktop Entry]
	Name=LocalSend
	Comment=An open-source cross-platform alternative to AirDrop
	Exec=localsend %U
	Icon=localsend
	Type=Application
	Terminal=false
	Categories=Network;FileTransfer;
	EOF
}
