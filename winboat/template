# Template file for 'winboat'
pkgname=winboat
version=0.9.2
revision=1
archs="x86_64"
create_wrksrc=yes
hostmakedepends="binutils tar xz"
depends="gtk+3 libnotify nss libXScrnSaver libXtst xdg-utils at-spi2-core
 libuuid libsecret libayatana-appindicator hicolor-icon-theme
 desktop-file-utils"
short_desc="Run Windows apps on Linux natively"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/TibixDev/winboat"
changelog="https://github.com/TibixDev/winboat/releases"
_gh="https://github.com/TibixDev/winboat/releases/download/v${version}"
distfiles="${_gh}/winboat-${version}-amd64.deb"
checksum=c01bfbabef6c1c57895dfb3165d4ca7c6912d2f63c67f61b2c2dd3e69449f0ba
replaces="winboat-bin>=0"
provides="winboat-bin-${version}_${revision}"
nopie=yes
nostrip=yes
nodebug=yes
noverifyrdeps=yes
noshlibprovides=yes

do_extract() {
	local _data

	ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/winboat-${version}-amd64.deb"
	_data=$(ls data.tar.* 2>/dev/null | head -n1)
	if [ -z "${_data}" ]; then
		msg_error "No data.tar.* found inside .deb\n"
	fi
	tar xf "${_data}"
	rm -f data.tar.* control.tar.* debian-binary
}

do_install() {
	vmkdir opt
	vcopy opt/winboat opt

	vmkdir usr/bin
	ln -sf /opt/winboat/winboat "${DESTDIR}/usr/bin/winboat"

	if [ -d usr/share/icons ]; then
		vmkdir usr/share
		vcopy usr/share/icons usr/share
	fi

	if [ -d usr/share/pixmaps ]; then
		vmkdir usr/share
		vcopy usr/share/pixmaps usr/share
	fi

	if [ -d usr/share/metainfo ]; then
		vmkdir usr/share
		vcopy usr/share/metainfo usr/share
	fi

	vmkdir usr/share/applications
	printf '%s\n' \
		"[Desktop Entry]" \
		"Name=WinBoat" \
		"Exec=winboat %U" \
		"Terminal=false" \
		"Type=Application" \
		"Icon=winboat" \
		"StartupWMClass=winboat" \
		"Comment=Windows for Penguins" \
		"Categories=Utility;" > "${DESTDIR}/usr/share/applications/winboat.desktop"

	if [ -f usr/share/doc/winboat/changelog.gz ]; then
		vdoc usr/share/doc/winboat/changelog.gz
	fi

	if [ -f usr/share/doc/winboat/copyright ]; then
		vlicense usr/share/doc/winboat/copyright
	fi
}
