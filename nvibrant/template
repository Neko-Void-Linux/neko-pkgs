# Template file for 'nvibrant'
pkgname=nvibrant
version=1.3.1
revision=1
archs="x86_64*"
depends="python3 python3-packaging"
short_desc="Nvidia digital vibrance and dithering on Wayland"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/Tremeschin/nvibrant"
distfiles="https://github.com/Tremeschin/nvibrant/releases/download/v${version}/nvibrant-${version}-py3-none-manylinux_2_17_x86_64.whl>nvibrant-${version}.zip"
checksum=d23fdfb75d78f8e94459bb6d741c6e3f1780b20deb0d0fac55b5aef3a915d6bf
nodebug=yes
python_version=3.14

do_install() {
	local _pyinst_dir="/usr/lib/python${python_version}/site-packages"

	vmkdir "${_pyinst_dir}"
	vcopy nvibrant "${_pyinst_dir}"
	vmkdir usr/bin
	printf '#!/usr/bin/env python3\nfrom nvibrant.__main__ import main\nmain()\n' \
		> ${DESTDIR}/usr/bin/nvibrant
	chmod 755 ${DESTDIR}/usr/bin/nvibrant
}

post_install() {
	vlicense ${FILESDIR}/LICENSE
}
