# Template file for 'waterfox'
pkgname=waterfox
version=6.7.8
revision=1
archs="x86_64"
makedepends="bzip2 wget tar"
short_desc="Fast and Private Web Browser"
maintainer="SelvinTY"
license="MPL-2.0"
homepage="https://www.waterfox.net/"
nopie=yes
wrksrc="waterfox"

do_fetch(){
	mkdir -p $wrksrc
	cd $wrksrc
	wget -O waterfox.tar.bz2 https://cdn.waterfox.com/waterfox/releases/${version}/Linux_x86_64/waterfox-${version}.tar.bz2
}
do_install() {
	cd $wrksrc
	tar -xjf waterfox.tar.bz2
	vmkdir opt/waterfox
	cd waterfox
	vcopy "*" opt/waterfox
	vmkdir usr/bin
	ln -s /opt/waterfox/waterfox "${DESTDIR}/usr/bin/waterfox"
	vmkdir usr/share/pixmaps
	vinstall "${DESTDIR}/opt/waterfox/browser/chrome/icons/default/default128.png" 644 \
usr/share/pixmaps/ waterfox.png
	vmkdir usr/share/applications
	vinstall "${FILESDIR}/waterfox.desktop" 644 usr/share/applications/
}
