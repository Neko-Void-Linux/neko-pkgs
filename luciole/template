post_patch() {
	vsed -i src/browser/directory_tree.cpp \
		-e 's/this auto&& self/auto\&\& self/' \
		-e 's/self[(]child/self(self, child/' \
		-e 's/append[(]entry/append(append, entry/'

	vsed -i src/browser/directory_model.cpp \
		-e 's/this auto&& self/auto\&\& self/' \
		-e 's/self[(]child/self(self, child/' \
		-e 's/append[(]id/append(append, id/'
}

post_install() {
	vlicense LICENSE
