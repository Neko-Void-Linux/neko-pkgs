# Template file for 'codex'
pkgname=codex
version=26.1103.60933
revision=1
archs="x86_64"
build_style=fetch
hostmakedepends="binutils tar xz"
depends="gtk+3 libnotify nss xdg-utils at-spi2-core libdrm mesa-dri libxcb glib
 alsa-lib at-spi2-atk atk cairo libcups dbus-libs expat libgcc gdk-pixbuf mesa
 nspr pango libstdc++ eudev-libudev libusb libX11 libXcomposite libXdamage
 libXext libXfixes libxkbcommon libXrandr libssl3 tpm2-tss vulkan-loader xz"
short_desc="OpenAI desktop app with ChatGPT and Codex CLI"
maintainer="CrowRei <Ortal.christopher@outlook.com>"
license="custom:Proprietary"
homepage="https://developers.openai.com/codex/app"
distfiles="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${version}_amd64.deb"
checksum=0746e9ba575182f5dbe32617b82a645eb93ad57ca588e5a9358695a6b65aee71
provides="codex-bin-${version}_${revision}"
replaces="codex-bin>=0 chatgpt>=0"
nostrip=yes
nodebug=yes
noshlibprovides=yes
noverifyrdeps=yes
nopie=yes

do_install() {
	vextract "chatgpt_${version}_amd64.deb"

	vmkdir usr/lib
	vcopy usr/lib/chatgpt usr/lib

	vmkdir usr/share
	[ ! -d usr/share/applications ] || vcopy usr/share/applications usr/share
	[ ! -d usr/share/pixmaps ] || vcopy usr/share/pixmaps usr/share

	vmkdir usr/bin
	[ ! -f usr/bin/chatgpt ] || vcopy usr/bin/chatgpt usr/bin
	if [ -x usr/lib/chatgpt/resources/codex ]; then
		ln -sf /usr/lib/chatgpt/resources/codex "${DESTDIR}/usr/bin/codex"
	fi
	if [ -x usr/lib/chatgpt/resources/codex-code-mode-host ]; then
		ln -sf /usr/lib/chatgpt/resources/codex-code-mode-host \
			"${DESTDIR}/usr/bin/codex-code-mode-host"
	fi

	[ ! -e usr/share/applications/chatgpt.desktop ] || \
		chmod 0644 "${DESTDIR}/usr/share/applications/chatgpt.desktop"
	[ ! -e usr/share/pixmaps/chatgpt.png ] || \
		chmod 0644 "${DESTDIR}/usr/share/pixmaps/chatgpt.png"

	[ ! -e usr/share/doc/chatgpt/copyright ] || \
		vlicense usr/share/doc/chatgpt/copyright
}
