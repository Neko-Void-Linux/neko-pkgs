pkgname=neko-icons
version=6.5
revision=1
archs=x86_64
wrksrc="neko-icons"
short_desc="Colección de iconos Neko"
makedepends="git"
maintainer="JavierC"
license="GPL-3.0-or-later"
homepage="https://github.com/Neko-Void-Linux/neko-icons"
do_build(){
    cd $wrksrc
    git clone --depth 1 https://github.com/Neko-Void-Linux/neko-icons.git .
}
do_install() {
    vcopy usr/share usr
}
