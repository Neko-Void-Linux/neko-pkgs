do_build() {
	mkdir -p usr/share/icons
	cp -a neko-icons-${_commit}/* .
	cp -a pixelitos-icon-theme-${_pixelitos_commit}/pixelitos-dark usr/share/icons/
	cp -a pixelitos-icon-theme-${_pixelitos_commit}/pixelitos-light usr/share/icons/
	cp -a pixora-icons-${_pixora_commit}/pixora-accent usr/share/icons/
	cp -a pixora-icons-${_pixora_commit}/pixora-dark usr/share/icons/
}

do_install() {
	vcopy usr/share usr
}
