pkgname=neko-icons
version=7.8
revision=6
archs=x86_64
wrksrc="neko-icons"
short_desc="Colección de iconos Neko"
makedepends="git"
maintainer="JavierC"
license="GPL-3.0-or-later"
homepage="https://github.com/Neko-Void-Linux/neko-icons"
do_build(){
    cd $wrksrc
    git clone --depth 1 https://github.com/ItsZariep/pixelitos-icon-theme.git tmp
    git clone --depth 1 https://github.com/tsora1603/pixora-icons.git tmp2
    git clone --depth 1 https://github.com/Neko-Void-Linux/neko-icons.git icons
    
    mkdir -p usr/share/icons
    cp -a icons/* .
    cp -a tmp/pixelitos-dark usr/share/icons/
    cp -a tmp/pixelitos-light usr/share/icons/
    cp -a tmp2/pixora-accent usr/share/icons/
    cp -a tmp2/pixora-dark usr/share/icons/
}
do_install() {
    vcopy usr/share usr
}
