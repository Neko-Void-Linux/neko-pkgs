# Template file for 'Neko-Wizard'
pkgname=Neko-Wizard
version=9.0.25
revision=2
_commit="38b0b46d3192e8914221bd168a4c32edb1b1026c"
build_style=meson
hostmakedepends="pkg-config meson ninja cmake"
makedepends="gtk4-devel"
short_desc="Wizard Post Install for NEKO VOID"
maintainer="JavierC"
license="WTFPL"
homepage="https://github.com/Neko-Void-Linux/Neko-Wizard"
distfiles="https://github.com/Neko-Void-Linux/Neko-Wizard/archive/${_commit}.tar.gz>${pkgname}-${version}.tar.gz"
checksum="f48826c661634919527c8a855ea5f85d4ce383df545899c5ffda7031b9719b7c"

do_extract() {
	vsrcextract --strip-components=1 ${pkgname}-${version}.tar.gz
}

do_install() {
	vmkdir usr/lib/Neko-Wizard
	vmkdir usr/bin
	vmkdir usr/share/applications
	vmkdir etc/xbps.d
	vcopy build/neko-store usr/lib/Neko-Wizard/neko-store
	chmod 755 "${DESTDIR}/usr/lib/Neko-Wizard/neko-store"

	vcopy resources usr/lib/Neko-Wizard/resources
	vcopy xbps.d/20-repository-neko.conf etc/xbps.d
	vcopy data usr/lib/Neko-Wizard/data

	ln -s ../lib/Neko-Wizard/neko-store "${DESTDIR}/usr/bin/neko-store"

	cat > "${DESTDIR}/usr/share/applications/neko-store.desktop" << 'DESKTOPEOF'
[Desktop Entry]
Type=Application
Name=Neko Wizard
Comment=WIZARD for INSTALL Software and DRIVERS
Exec=neko-store
Icon=system-software-install
Categories=Utility;
Terminal=false
DESKTOPEOF
	chmod 644 "${DESTDIR}/usr/share/applications/neko-store.desktop"

	if [ -f LICENSE ]; then
		vlicense LICENSE
	fi
}
