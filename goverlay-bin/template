# Template file for 'goverlay-bin'
pkgname=goverlay-bin
version=1.9.4
revision=1
archs="x86_64"
hostmakedepends="tar xz"
depends="MangoHud qt6-base qt6-declarative gamemode nerd-fonts libqt6pas-bin
 python3"
short_desc="Modern Qt6 GUI application to configure MangoHud, vkBasalt, and
 more"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/benjamimgois/Goverlay"
distfiles="https://github.com/benjamimgois/goverlay/releases/download/${version}/goverlay-${version}-x86_64.deb"
checksum=83f765dfb9725755db38883f1cdd6f57c8bc690a8cb0f30f2b6dd9f87a4729ca
provides="goverlay-${version}_${revision}"
nopie=yes

do_extract() {
	ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/goverlay-${version}-x86_64.deb
}

do_install() {
	tar xf data.tar.* -C ${DESTDIR}
}
