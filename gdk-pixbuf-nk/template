# Template file for 'gdk-pixbuf-nk'
pkgname=gdk-pixbuf-nk
version=2.44.8
revision=2
build_style=meson
build_helper="gir"
configure_args="$(vopt_feature gir introspection) -Dpng=enabled
 -Djpeg=enabled -Dtiff=enabled -Dgif=enabled -Dglycin=enabled
 -Dothers=enabled -Dinstalled_tests=false -Dtests=false -Ddocumentation=false
 -Dman=false"
hostmakedepends="gettext-devel glib-devel pkg-config"
makedepends="glib-devel libpng-devel tiff-devel libjpeg-turbo-devel
 shared-mime-info glycin-devel"
depends="shared-mime-info"
short_desc="Image loading library for The GTK+ toolkit (v2) - latest 2.44 release"
maintainer="Dicov <SrDicov@gmail.com>"
license="LGPL-2.1-or-later"
homepage="https://wiki.gnome.org/Projects/GdkPixbuf"
distfiles="${GNOME_SITE}/gdk-pixbuf/${version%.*}/gdk-pixbuf-${version}.tar.xz"
checksum=919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c
provides="gdk-pixbuf-${version}_${revision}"
replaces="gdk-pixbuf>=0"
conflicts="gdk-pixbuf>=0"

# Package build options
build_options="gir"
build_options_default="gir"

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" gdk-pixbuf-devel"
fi

pre_configure() {
	if [ "$CROSS_BUILD" ]; then
		touch gdk-pixbuf/loaders.cache
	fi
}

gdk-pixbuf-devel-nk_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	provides="gdk-pixbuf-devel-${version}_${revision} gdk-pixbuf-nk-devel-${version}_${revision}"
	replaces="gdk-pixbuf-devel>=0 gdk-pixbuf-nk-devel>=0"
	conflicts="gdk-pixbuf-devel>=0 gdk-pixbuf-nk-devel>=0"
	pkg_install() {
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove "usr/bin/*csource*"
		if [ -d "${PKGDESTDIR}/usr/share/man/man1" ]; then
			vmove "usr/share/man/man1/*csource*"
		fi
		if [ "$build_option_gir" ]; then
			vmove usr/share/gir-1.0
		fi
	}
}
