pkgname=neko-backgrounds
version=7.2
revision=4
wrksrc="neko-backgrounds"
short_desc="Colección de fondos de pantalla Neko"
maintainer="JavierC"
makedepends="git"
license="GPL-3.0-or-later"
homepage="https://github.com/Neko-Void-Linux/neko-backgrounds"
do_build(){
    cd $wrksrc
    git clone --depth 1 https://github.com/Neko-Void-Linux/neko-backgrounds.git .
    mkdir usr/share/wallpapers
    ln -s usr/share/backgrounds/* usr/share/wallpapers/
}
do_install() {
    vcopy usr/share usr
}
