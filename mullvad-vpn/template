# Template file for 'mullvad-vpn'
pkgname=mullvad-vpn
version=2026.5
revision=2
archs="x86_64"
hostmakedepends="binutils tar xz curl gnupg2"
depends="wireguard-tools"
short_desc="Mullvad VPN client for Linux (unofficial Void package)"
maintainer="JavierC <tu@email.com>"
license="custom:Proprietary"
homepage="https://mullvad.net"
distfiles="https://github.com/mullvad/mullvadvpn-app/releases/download/${version}/MullvadVPN-${version}_amd64.deb"
checksum=aa6bd00452588597f50e8ca2f02bb91e9c295c4f01b0ae907354552e7428e7ab
provides="mullvad-vpn-bin-${version}_${revision}"
replaces="mullvad-vpn-bin>=0"

do_extract() {
	ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/MullvadVPN-${version}_amd64.deb
	mkdir -p ${wrksrc}
	tar xf data.tar.* -C ${wrksrc}
}

do_install() {
	vmkdir /opt
	vmkdir usr/bin
	vmkdir usr/share/applications
	vmkdir usr/share/icons/hicolor
	vmkdir usr/share/bash-completion/completions
	vmkdir usr/share/fish/vendor_completions.d
	vmkdir etc/profile.d
	vmkdir /var/log/mullvad-daemon
	vmkdir /var/log/mullvad-vpn
	vmkdir /var/cache/mullvad-vpn
	vmkdir /etc/mullvad-vpn
	vmkdir etc/sv/mullvad-daemon/log

	vcopy opt/Mullvad\ VPN /opt/

	vbin usr/bin/mullvad
	vbin usr/bin/mullvad-daemon
	vinstall usr/bin/mullvad-exclude 4755 /usr/bin mullvad-exclude

	ln -sf "/opt/Mullvad VPN/resources/mullvad-problem-report" \
		"${DESTDIR}/usr/bin/mullvad-problem-report"

	vcopy usr/share/applications/mullvad-vpn.desktop /usr/share/applications/
	vcopy usr/share/icons/hicolor /usr/share/icons/

	vcopy usr/share/bash-completion/completions/mullvad /usr/share/bash-completion/completions/
	vcopy usr/share/fish/vendor_completions.d/mullvad.fish /usr/share/fish/vendor_completions.d/

	vinstall ${FILESDIR}/mullvad.sh 644 etc/profile.d mullvad.sh

	vinstall ${FILESDIR}/mullvad-daemon-run 755 etc/sv/mullvad-daemon run

	vinstall ${FILESDIR}/mullvad-daemon-log-run 755 etc/sv/mullvad-daemon/log run

	vlicense opt/Mullvad\ VPN/LICENSE 2>/dev/null || true
}

post_install() {
	vdoc ${FILESDIR}/README.void
}
