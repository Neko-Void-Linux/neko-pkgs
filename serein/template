# Template file for 'serein'
pkgname=serein
version=1.0.0pre20261105.76
revision=1
archs="x86_64"
build_style=fetch
hostmakedepends="7zip"
depends="gtk4 libwebkitgtk60 libsoup3 glib alsa-lib libpulseaudio gstreamer1
 gst-plugins-base1 gst-plugins-good1 gstreamer1-pipewire libxkbcommon
 hicolor-icon-theme xdg-desktop-portal dbus"
short_desc="Experimental unofficial native Discord client"
maintainer="Dicov <SrDicov@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://github.com/ViceVerse-cz/Serein"
_tag="v1.0.0-nightly.20261105.76"
distfiles="https://github.com/ViceVerse-cz/Serein/releases/download/${_tag}/serein-${_tag}-Linux-X64.AppImage"
checksum=b3c437c5ca0c2f3b68d746dd07ce752b28d66568bb2636c8b25f660ab896156a
provides="serein-bin-${version}_${revision}"
replaces="serein-bin>=0"
nostrip=yes
noshlibprovides=yes

post_extract() {
	local appimg="serein-${_tag}-Linux-X64.AppImage"
	if command -v 7z >/dev/null 2>&1; then
		7z x -y "${appimg}"
	elif command -v 7zip >/dev/null 2>&1; then
		7zip x -y "${appimg}"
	else
		chmod +x "${appimg}"
		"./${appimg}" --appimage-extract
		mv squashfs-root/* .
	fi
}

do_install() {
	vbin usr/bin/serein
	vinstall cz.viceverse.serein.desktop 644 usr/share/applications
	ln -sf cz.viceverse.serein.desktop "${DESTDIR}/usr/share/applications/serein.desktop"
	vmkdir usr/share/icons
	vcopy "usr/share/icons/*" usr/share/icons
	vlicense usr/share/doc/serein/LICENSE-MIT
	vlicense usr/share/doc/serein/LICENSE-APACHE
}
