# Template file for 'waveform-free'
pkgname=waveform-free
version=2026.14.1.23
revision=1
_debver="14.1.23"
archs="x86_64"
create_wrksrc=yes
hostmakedepends="binutils tar"
depends="curl alsa-lib xprop tracktion-download-manager"
short_desc="DAW WAVEFORM FREE"
maintainer="JavierC"
license="custom:Proprietary"
homepage="http://www.tracktion.com"
distfiles="https://github.com/Neko-Void-Linux/Neko-Wizard/releases/download/debs/waveform14_${_debver}_amd64.deb"
checksum=73f4c4efb6a88022a14f01a0dfe790df8fa37f09539569ea463d9e52dc62b99c
nostrip=yes

do_extract() {
	ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/waveform14_${_debver}_amd64.deb"
	tar -xf data.tar.gz
}

do_install() {
	vcopy usr .
	if [ -f usr/share/doc/waveform14/copyright ]; then
		vlicense usr/share/doc/waveform14/copyright LICENSE
	elif [ -f usr/share/doc/Waveform14/copyright ]; then
		vlicense usr/share/doc/Waveform14/copyright LICENSE
	fi
}
