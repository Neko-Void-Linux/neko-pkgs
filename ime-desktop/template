# Template file for 'ime-desktop'
pkgname=ime-desktop
version=7.3.4
revision=1
archs="x86_64"
depends="alsa-lib ca-certificates dbus hicolor-icon-theme libglvnd libX11
 libXcomposite libXcursor libXdamage libXext libXfixes libXi libXinerama
 libXrandr libXrender libXtst libxcb libxkbcommon libxkbcommon-x11
 libpulseaudio libpipewire libsecret libwebkitgtk60 mesa-dri pango
 xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil
 xcb-util-wm xdg-utils"
short_desc="Telegram-based messaging client with AI features"
maintainer="ANOMALI0x00 <SrDicov@gmail.com>"
license="custom:Proprietary"
homepage="https://imem.me/"
distfiles="https://imem.app/download/desktop/linux>iMe_Desktop_Linux-${version}.tar.xz"
checksum=fe7567821f965d5548a3aa2b86f249aa3c761a3b7cac7c3119836507447c6c5b
nostrip=yes
nopie=yes
noshlibprovides=yes

do_install() {
	vmkdir usr/libexec/ime-desktop
	vcopy iMe usr/libexec/ime-desktop
	vcopy Updater usr/libexec/ime-desktop
	vbin "${FILESDIR}/ime-wrapper" iMe
	vinstall "${FILESDIR}/ime.desktop" 644 usr/share/applications org.ime.desktop.desktop
	vinstall "${FILESDIR}/org.ime.desktop.svg" 644 usr/share/icons/hicolor/scalable/apps
	vinstall "${FILESDIR}/org.ime.desktop.png" 644 usr/share/pixmaps
	vlicense "${FILESDIR}/LICENSE"
}
