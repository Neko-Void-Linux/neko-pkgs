# Template file for 'tracktion-download-manager'
pkgname=tracktion-download-manager
version=2026.10
revision=1
archs="x86_64"
hostmakedepends="tar xz wget"
depends="curl alsa-lib xprop"
short_desc="Tracktion Download Manager"
maintainer="JavierC <javiercyt@atomicmail.io>"
license="custom:Proprietary"
homepage="http://www.tracktion.com"
nostrip=yes

do_fetch() {
	mkdir -p ${XBPS_SRCDISTDIR}/${pkgname}-${version}
	wget -O ${XBPS_SRCDISTDIR}/${pkgname}-${version}/tracktion_download_manager_v1.5.3.deb https://downloads.tracktion.com/download-mgr/153/tracktion_download_manager_v1.5.3.deb
}

do_extract() {
	mkdir -p ${DESTDIR}
	ar x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/tracktion_download_manager_v1.5.3.deb
}

do_install() {
	tar xf data.tar.xz -C ${DESTDIR}
}
