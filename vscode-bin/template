# Template file for 'vscode-bin'
pkgname=vscode-bin
version=1.145.2
revision=1
archs="x86_64"
create_wrksrc=yes
hostmakedepends="tar"
depends="libXtst nss nspr alsa-lib gtk+3 libsecret libnotify libXScrnSaver
 xdg-utils desktop-file-utils"
short_desc="Visual Studio Code (official Microsoft binary release)"
maintainer="ANOMALI0x00 <SrDicov@gmail.com>"
license="custom:Unfree"
homepage="https://code.visualstudio.com"
_commit=a717861c07586a53d83b80d742cd3f59b20a6273
_timestamp=1793749246
distfiles="https://vscode.download.prss.microsoft.com/dbazure/download/stable/c4453f8ea430795f941c1b2ff6c9321135a74a02/code-stable-x64-1793945155.tar.gz"
checksum=3b01286639fa026fd860944b811d418f7b93bc5dc447d9e607b0cd1377cfbaa2
nostrip=yes
nopie=yes
noshlibprovides=yes

do_extract() {
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}"/*.tar.gz \
		-C "${wrksrc}" --strip-components=1
}

do_install() {
	vmkdir usr/lib/code
	vcopy "*" usr/lib/code/

	if [ -f "${DESTDIR}/usr/lib/code/chrome-sandbox" ]; then
		chmod 4755 "${DESTDIR}/usr/lib/code/chrome-sandbox"
	fi

	vmkdir usr/bin
	ln -sf /usr/lib/code/bin/code "${DESTDIR}/usr/bin/code"
	if [ -f "${DESTDIR}/usr/lib/code/bin/code-tunnel" ]; then
		ln -sf /usr/lib/code/bin/code-tunnel "${DESTDIR}/usr/bin/code-tunnel"
	fi

	local icon_src="${DESTDIR}/usr/lib/code/resources/app/resources/linux/code.png"
	if [ -f "$icon_src" ]; then
		vmkdir usr/share/pixmaps
		ln -sf /usr/lib/code/resources/app/resources/linux/code.png "${DESTDIR}/usr/share/pixmaps/vscode.png"
		vmkdir usr/share/icons/hicolor/512x512/apps
		ln -sf /usr/lib/code/resources/app/resources/linux/code.png "${DESTDIR}/usr/share/icons/hicolor/512x512/apps/vscode.png"
	fi

	if [ -f "${DESTDIR}/usr/lib/code/resources/completions/bash/code" ]; then
		vmkdir usr/share/bash-completion/completions
		ln -sf /usr/lib/code/resources/completions/bash/code "${DESTDIR}/usr/share/bash-completion/completions/code"
	fi
	if [ -f "${DESTDIR}/usr/lib/code/resources/completions/zsh/_code" ]; then
		vmkdir usr/share/zsh/site-functions
		ln -sf /usr/lib/code/resources/completions/zsh/_code "${DESTDIR}/usr/share/zsh/site-functions/_code"
	fi

	vmkdir usr/share/applications

	cat > "${DESTDIR}/usr/share/applications/code.desktop" <<-EOF
	[Desktop Entry]
	Name=Visual Studio Code
	Comment=Code Editing. Redefined.
	GenericName=Text Editor
	Exec=/usr/lib/code/bin/code --password-store="gnome-libsecret" --unity-launch %F
	Icon=vscode
	Type=Application
	StartupNotify=false
	StartupWMClass=Code
	Categories=Utility;TextEditor;Development;IDE;
	MimeType=text/plain;inode/directory;application/x-code-workspace;
	Actions=new-empty-window;
	Keywords=vscode;code;editor;development;

	[Desktop Action new-empty-window]
	Name=New Empty Window
	Exec=/usr/lib/code/bin/code --password-store="gnome-libsecret" --new-window %F
	Icon=vscode
	EOF

	cat > "${DESTDIR}/usr/share/applications/code-url-handler.desktop" <<-EOF
	[Desktop Entry]
	Name=Visual Studio Code - URL Handler
	Comment=Code Editing. Redefined.
	GenericName=Text Editor
	Exec=/usr/lib/code/bin/code --password-store="gnome-libsecret" --open-url %U
	Icon=vscode
	Type=Application
	NoDisplay=true
	StartupNotify=false
	StartupWMClass=Code
	Categories=Utility;TextEditor;Development;IDE;
	MimeType=x-scheme-handler/vscode;
	Keywords=vscode;
	EOF

	if [ -f "${DESTDIR}/usr/lib/code/resources/app/LICENSE.rtf" ]; then
		vlicense "${DESTDIR}/usr/lib/code/resources/app/LICENSE.rtf"
	fi
}
