# Template file for 'cinnabar'
pkgname=cinnabar
version=0.2.1
revision=1
archs="x86_64"
build_style=fetch
hostmakedepends="7zip"
depends="alsa-lib eudev-libudev desktop-file-utils hicolor-icon-theme xdg-utils"
short_desc="Unofficial client compatible with Minecraft: Bedrock Edition"
maintainer="Dicov <SrDicov@gmail.com>"
license="custom:PolyForm-Noncommercial-1.0.0"
homepage="https://cinnabar.gg"
distfiles="https://github.com/cinnabar-mc/cinnabar/releases/download/v${version}/Cinnabar-x86_64.AppImage"
checksum=0a042102e8f11dc648ba9d251757e3bd06c143dbef085423296b768d7ab1d136
provides="cinnabar-bin-${version}_${revision}"
replaces="cinnabar-bin>=0"
nostrip=yes
noshlibprovides=yes
ignore_elf_dirs="/usr/share/cinnabar/prep-kit/bin"
ignore_elf_files="/usr/share/cinnabar/prep-kit/bin/assetc"

post_extract() {
	local appimg="Cinnabar-x86_64.AppImage"
	if command -v 7z >/dev/null 2>&1; then
		7z x -y "${appimg}"
	elif command -v 7zip >/dev/null 2>&1; then
		7zip x -y "${appimg}"
	else
		chmod +x "${appimg}"
		"./${appimg}" --appimage-extract
		mv squashfs-root/* .
	fi
}

do_install() {
	vbin usr/bin/cinnabar
	vbin usr/bin/bedrock-core
	vbin usr/bin/bedrock-local-server
	vbin usr/bin/cinnabar-cxb
	vinstall cinnabar.desktop 644 usr/share/applications
	vinstall cinnabar.png 644 usr/share/pixmaps cinnabar.png
	vmkdir usr/share
	vcopy "usr/share/*" usr/share
	vlicense usr/share/cinnabar/licenses/Cinnabar-LICENSE.md LICENSE
}
